{
  "_comment": "样例2：并行网关 + 会签（过半收口）+ 角色办理人 + 抄送 + 终止型终点。P0：会签由 approvalDefs 的 mode=PARALLEL_COUNTERSIGN + collectionVar/elementVar 驱动（编译器生成 MI 域，spec 不写 mi）；发起人节点用 kind=INITIATOR；抄送在 NodeApproval.cc",
  "key": "contract_review",
  "name": "合同评审",
  "nodes": [
    {"id": "apply", "type": "userTask", "name": "发起申请"},
    {"id": "fork", "type": "parallelGateway"},
    {"id": "legal", "type": "userTask", "name": "法务审核"},
    {"id": "sign", "type": "userTask", "name": "评审会签"},
    {"id": "join", "type": "parallelGateway"},
    {"id": "boss", "type": "userTask", "name": "总经理审批"},
    {"id": "gw2", "type": "exclusiveGateway", "name": "结果", "defaultTo": "pass"},
    {"id": "pass", "type": "endEvent", "name": "通过"},
    {"id": "veto", "type": "endEvent", "name": "一票否决", "terminate": true}
  ],
  "flows": [
    {"from": "apply", "to": "fork"},
    {"from": "fork", "to": "legal"},
    {"from": "fork", "to": "sign"},
    {"from": "legal", "to": "join"},
    {"from": "sign", "to": "join"},
    {"from": "join", "to": "boss"},
    {"from": "boss", "to": "gw2"},
    {"from": "gw2", "to": "veto", "condition": "${rejected == true}", "name": "否决"},
    {"from": "gw2", "to": "pass"}
  ],
  "approvalDefs": {
    "orgId": "zongbu",
    "note": "样例：发起人确认 + 角色或签 + 集合会签过半 + 组织领导终审 + 抄送",
    "nodes": {
      "apply": {"inherit": false, "mode": "SINGLE", "objects": [{"kind": "INITIATOR", "value": ""}],
                "cc": [{"kind": "USER", "value": "u_auditor1"}]},
      "legal": {"inherit": false, "mode": "ANY", "objects": [{"kind": "ROLE", "value": "finance"}]},
      "sign": {"inherit": false, "mode": "PARALLEL_COUNTERSIGN",
               "collectionVar": "reviewers", "elementVar": "reviewer",
               "completionCondition": "${nrOfCompletedInstances/nrOfInstances >= 0.5}"},
      "boss": {"inherit": false, "mode": "SINGLE", "objects": [{"kind": "ORG_LEADER", "value": ""}]}
    }
  },
  "deploy": {"server": "http://127.0.0.1:8091", "note": "cmx-flow-toolkit 样例", "publishedBy": "agent"},
  "smoke": {"orgId": "zongbu", "businessKey": "SMOKE-CTR-001",
            "variables": {"initiator": "u_emp", "rejected": false,
                          "reviewers": ["u_fin1", "u_fin2", "u_fin3"]},
            "expectActive": ["apply"]}
}
