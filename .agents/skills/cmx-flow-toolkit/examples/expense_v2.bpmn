<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:flowable="http://flowable.org/bpmn"
                  xmlns:cmx="http://cmx.io/bpmn"
                  targetNamespace="http://cmx.io/flow/created"
                  id="defs_expense_v2">
  <bpmn:process id="expense_v2" name="报销审批v2" isExecutable="true">
    <bpmn:startEvent id="s" name="发起"/>
    <bpmn:userTask id="mgr" name="部门经理审批"/>
    <bpmn:exclusiveGateway id="gw" name="金额判断" default="f4"/>
    <bpmn:userTask id="director" name="总监审批"/>
    <bpmn:callActivity id="fin" name="财务复核（按组织路由）" cmx:calledKey="fin_review" cmx:inVars="amount:subAmount" cmx:outVars="finResult"/>
    <bpmn:userTask id="cashier" name="出纳打款"/>
    <bpmn:endEvent id="done" name="报销完成"/>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="mgr"/>
    <bpmn:sequenceFlow id="f2" sourceRef="mgr" targetRef="gw"/>
    <bpmn:sequenceFlow id="f3" name="大额" sourceRef="gw" targetRef="director">
      <bpmn:conditionExpression>${amount &gt; 20000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="gw" targetRef="fin"/>
    <bpmn:sequenceFlow id="f5" sourceRef="director" targetRef="fin"/>
    <bpmn:sequenceFlow id="f6" sourceRef="fin" targetRef="cashier"/>
    <bpmn:sequenceFlow id="f7" sourceRef="cashier" targetRef="done"/>
  </bpmn:process>
</bpmn:definitions>
