 "functions": [
  {
   "apiName": "supplierGrade",
   "displayName": "供应商评级",
   "runtime": "feel",
   "kind": "derivedProperty",
   "inputs": [
    {
     "name": "supplier",
     "type": "object"
    }
   ],
   "body": "if supplier.rating >= 4.5 then \"A\" else if supplier.rating >= 3.5 then \"B\" else if supplier.rating >= 2.5 then \"C\" else \"D\"",
   "status": "active"
  },
  {
   "apiName": "supplierRiskScore",
   "displayName": "供应商风险分",
   "runtime": "rhai",
   "kind": "derivedProperty",
   "inputs": [
    {
     "name": "supplier",
     "type": "object"
    }
   ],
   "body": "let riskDed = if supplier.riskLevel == \"高\" { 40.0 } else if supplier.riskLevel == \"中\" { 20.0 } else { 0.0 };\nlet otDed = (100.0 - supplier.onTimeRate) * 2.0;\nlet lowDed = if supplier.rating < 3.0 { 15.0 } else { 0.0 };\nlet s = 100.0 - riskDed - otDed - lowDed;\nif s < 0.0 { 0.0 } else { s }",
   "status": "active"
  },
  {
   "apiName": "contractSpendBySupplier",
   "displayName": "按供应商汇总合同额",
   "runtime": "feel",
   "kind": "aggregation",
   "inputs": [
    {
     "name": "contracts",
     "type": "objectSet"
    }
   ],
   "body": "{\"kind\":\"groupSum\",\"groupBy\":\"supplierName\",\"sum\":\"amount\"}",
   "status": "active"
  },
  {
   "apiName": "materialFullLabel",
   "displayName": "物料全称标签",
   "runtime": "feel",
   "kind": "derivedProperty",
   "inputs": [
    {
     "name": "material",
     "type": "object"
    }
   ],
   "body": "material.category + \" / \" + material.name + \"（\" + material.unit + \"）\"",
   "status": "active"
  }
 ],
 "actions": [
  {
   "apiName": "submitSupplierReview",
   "displayName": "提交供应商评审（发起流程）",
   "description": "供应商置评审中并发起 supplier_review 审批流；审批通过后由 flow-callback 回写 reviewStatus=已通过",
   "status": "active",
   "parameters": [
    {
     "name": "supplierId",
     "type": "string",
     "required": true
    }
   ],
   "logic": [
    {
     "op": "modifyObject",
     "objectType": "Supplier",
     "pk": "$supplierId",
     "set": {
      "reviewStatus": "评审中"
     }
    }
   ],
   "sideEffects": [
    {
     "kind": "startBusinessProcess",
     "flowDefKey": "supplier_review",
     "businessKey": "$supplierId",
     "orgId": "org-root",
     "initiator": "7503326638169403392",
     "supplierId": "$supplierId"
    }
   ]
  },
  {
   "apiName": "pauseSupplier",
   "displayName": "暂停合作",
   "status": "active",
   "parameters": [
    {
     "name": "supplierId",
     "type": "string",
     "required": true
    },
    {
     "name": "reason",
     "type": "string",
     "required": true
    }
   ],
   "logic": [
    {
     "op": "modifyObject",
     "objectType": "Supplier",
     "pk": "$supplierId",
     "set": {
      "status": "停用",
      "remark": "$reason"
     }
    }
   ],
   "sideEffects": [
    {
     "kind": "notification",
     "template": "供应商暂停合作通知",
     "reason": "$reason"
    }
   ]
  },
  {
   "apiName": "adjustSupplierRating",
   "displayName": "调整供应商评分",
   "status": "active",
   "parameters": [
    {
     "name": "supplierId",
     "type": "string",
     "required": true
    },
    {
     "name": "newRating",
     "type": "double",
     "required": true
    }
   ],
   "validations": [
    {
     "expression": "newRating >= 0 and newRating <= 5",
     "message": "评分必须在 0~5 之间"
    }
   ],
   "logic": [
    {
     "op": "modifyObject",
     "objectType": "Supplier",
     "pk": "$supplierId",
     "set": {
      "rating": "$newRating"
     }
    }
   ]
  },
  {
   "apiName": "createMaterial",
   "displayName": "新增物料",
   "status": "active",
   "parameters": [
    {
     "name": "materialCode",
     "type": "string",
     "required": true
    },
    {
     "name": "name",
     "type": "string",
     "required": true
    },
    {
     "name": "category",
     "type": "string",
     "required": true
    },
    {
     "name": "unit",
     "type": "string",
     "required": true
    }
   ],
