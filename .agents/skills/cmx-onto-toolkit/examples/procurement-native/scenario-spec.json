  {
   "apiName": "applyNewSupplier",
   "displayName": "新增供应商申请（发起主数据治理）",
   "description": "本体动作发起供应商主数据变更：webhook 调 MDM webhook-create 建 CR 并提交 → 门户待办审批 → 激活铸号写 cm_supplier → MDM 事件推送自动回流本体（双向打通）",
   "status": "active",
   "parameters": [
    {
     "name": "supplierName",
     "type": "string",
     "required": true
    },
    {
     "name": "taxNo",
     "type": "string",
     "required": true
    },
    {
     "name": "phone",
     "type": "string",
     "required": false
    }
   ],
   "logic": [],
   "sideEffects": [
    {
     "kind": "webhook",
     "url": "http://127.0.0.1:8095/api/mdm/change-requests/webhook-create",
     "docType": "gys",
     "targetDictCode": "supplier",
     "crType": "create",
     "createBy": "7503326638169403392",
     "payload": {
      "name": "$supplierName",
      "tax_no": "$taxNo",
      "phone": "$phone"
     }
    }
   ]
  }
