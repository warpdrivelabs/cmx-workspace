  {
   "apiName": "adjustSafetyStock",
   "displayName": "调整安全库存",
   "status": "active",
   "parameters": [
    {
     "name": "materialId",
     "type": "string",
     "required": true
    },
    {
     "name": "newStock",
     "type": "long",
     "required": true
    }
   ],
   "validations": [
    {
     "expression": "newStock >= 0",
