  "funnelMappings": [
    {
      "objectType": "Supplier",
      "sourceDbId": "fico-db",
      "sourceQuery": "SELECT code, name, short_name, industry, legal_person, address, phone, risk_level, supplier_category, lifecycle_status, (CASE WHEN risk_level='low' THEN 4.6 WHEN risk_level='medium' THEN 3.8 ELSE 2.4 END)::double precision AS rating, (CASE WHEN risk_level='low' THEN 96.5 WHEN risk_level='medium' THEN 88.0 ELSE 70.0 END)::double precision AS on_time_rate, (CASE WHEN status=1 THEN '合作中' ELSE '已停用' END) AS status FROM cm_supplier UNION ALL SELECT 'SUP-BAD', NULL, NULL, NULL, NULL, NULL, NULL, 'low', 'normal', 'published', 4.0::double precision, 90.0::double precision, '合作中'",
      "keyColumns": [
        "code"
      ],
      "titleColumn": "name",
      "propertyMap": [
        {
          "source": "code",
          "property": "supplierCode"
        },
        {
